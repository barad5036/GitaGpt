# GitaGPT Self-Hosted Production Backend Environment (.env.example)
# NEVER commit real secrets to git. Generate 32-byte hex keys via:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"

NODE_ENV=development
PORT=8000

# 32-byte (64 hex chars) Master Key Encryption Key (KEK) for Envelope Encryption
MASTER_KEK_HEX=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef
MASTER_KEK_VERSION=1

# Optional previous KEK for seamless key rotation (v1 -> v2)
# MASTER_KEK_PREV_HEX=
# MASTER_KEK_PREV_VERSION=1

# 32-byte (64 hex chars) secret for short-lived (15m) HS256 Access JWTs
JWT_ACCESS_SECRET=fedcba9876543210fedcba9876543210fedcba9876543210fedcba9876543210
ACCESS_TOKEN_TTL_SEC=900
REFRESH_TOKEN_TTL_DAYS=30

# Self-Hosted PostgreSQL 16 + pgvector connection string
DATABASE_URL=postgresql://gitagpt:gitagpt_secret@localhost:5432/gitagpt

# Google OAuth 2.0 Client IDs (Web & Android)
GOOGLE_WEB_CLIENT_ID=your-web-client-id.apps.googleusercontent.com
GOOGLE_ANDROID_CLIENT_ID=your-android-client-id.apps.googleusercontent.com

# Strict CORS Allow-List (Web + Capacitor Android)
ALLOWED_ORIGINS=http://localhost:5173,https://localhost,capacitor://localhost

# Rate Limiting & Guest Trial Quotas
RATE_LIMIT_PER_MIN=60
USER_DAILY_QUOTA=200
GUEST_DAILY_QUOTA=15

# AI provider (any OpenAI-compatible endpoint). The key stays on the server.
# If the primary provider fails, requests automatically fall back to Pollinations.
#
#   Local / self-hosted (Ollama):  LLM_BASE_URL=http://localhost:11434/v1        LLM_MODEL=qwen2.5:7b
#   Groq (fast, free key):          LLM_BASE_URL=https://api.groq.com/openai/v1  LLM_MODEL=llama-3.3-70b-versatile
#   OpenRouter:                     LLM_BASE_URL=https://openrouter.ai/api/v1    LLM_MODEL=meta-llama/llama-3.3-70b-instruct
#   Pollinations (default):         LLM_BASE_URL=https://text.pollinations.ai/openai  LLM_MODEL=openai
#     Without a key Pollinations allows ~1 reply per 45s per IP. Add a pollen key in LLM_API_KEY for unlimited use.
LLM_BASE_URL=https://text.pollinations.ai/openai
LLM_MODEL=openai
LLM_API_KEY=

# Self-Hosted Error Tracking (GlitchTip / Sentry DSN)
SENTRY_DSN=
