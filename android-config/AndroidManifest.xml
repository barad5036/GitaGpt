<?xml version="1.0" encoding="utf-8"?>
<!--
  GitaGPT Android Security Configuration (Self-Hosted HTTPS API Only — Zero Firebase)
  - allowBackup="false" and fullBackupContent="false" prevent Android Keystore-wrapped
    refresh tokens and encrypted local chat caches from ever being exported to cloud backups.
  - networkSecurityConfig="@xml/network_security_config" enforces TLS 1.2+ and blocks cleartext HTTP.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="org.gitagpt.app">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.RECORD_AUDIO" />

    <application
        android:allowBackup="false"
        android:fullBackupContent="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:networkSecurityConfig="@xml/network_security_config"
        android:usesCleartextTraffic="false"
        android:label="GitaGPT"
        android:icon="@mipmap/ic_launcher"
        android:supportsRtl="true">
    </application>
</manifest>
